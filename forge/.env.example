# Forge parity fixture generation env.
#
# Fill these values locally before running:
#
#   cd forge
#   FORGE_PARITY_SCENARIO=all \
#   forge script script/ForgeParityFixture.s.sol:ForgeParityFixture \
#     -vv
#
# The generated fixture is consumed from the Rust crate root with:
#
#   FORGE_PARITY_FIXTURE=forge/fixtures/parity.json \
#   cargo test --all-features --test forge_parity -- --ignored

# RPC / fork.
# The script reads these values and calls vm.createSelectFork internally, so no
# --fork-url / --fork-block-number CLI flags are needed.
ETH_RPC_URL=
FOUNDRY_FORK_BLOCK_NUMBER=

# Uniswap V4 deployment address for the selected chain/block.
# The script reads pool state directly from PoolManager.extsload using the
# v4-core StateLibrary storage layout, so no periphery StateView address is needed.
POOL_MANAGER=0x0000000000000000000000000000000000000000

# PoolKey
# Use 0x0000000000000000000000000000000000000000 for native currency.
CURRENCY0=0x0000000000000000000000000000000000000000
CURRENCY1=0x0000000000000000000000000000000000000000
FEE=3000
TICK_SPACING=60
HOOKS=0x0000000000000000000000000000000000000000

# Optional logical owner used in the Rust fixture.
# Defaults to the script contract if left as zero in the Solidity script flow.
OWNER=0x0000000000000000000000000000000000000000

# Funding accounts on the fork.
# If FUND0/FUND1 is 0, the script queries the corresponding whale balance.
# For native currency, the script uses vm.deal instead of ERC20 transfer.
TOKEN0_WHALE=0x0000000000000000000000000000000000000000
TOKEN1_WHALE=0x0000000000000000000000000000000000000000
FUND0=0
FUND1=0

# Scenario selection.
# Use "all" or a comma-separated list:
#   no-cross,cross-one-tick,exact-output,protocol-fee,one-for-zero-cross
FORGE_PARITY_SCENARIO=all

# Optional scenario overrides.
# The script reads the current pool tick from PoolManager storage, then computes:
#   lower = floor_to_spacing(current_tick - TICK_LOWER_OFFSET)
#   upper = ceil_to_spacing(current_tick + TICK_UPPER_OFFSET)
#
# Leave offsets and SWAP_AMOUNT as 0 to use the selected scenario preset.
TICK_LOWER_OFFSET=0
TICK_UPPER_OFFSET=0
LIQUIDITY_DELTA=1000000
SWAP_EXACT_OUTPUT=false
SWAP_AMOUNT=0
PROTOCOL_FEE=0

# Backward-compatible fallback when SWAP_AMOUNT is omitted.
SWAP_AMOUNT_IN=1000000

# Output path relative to forge/.
FORGE_PARITY_OUT=fixtures/parity.json
